# ==============================================================================
# VIVEK DHOUNDIYAL — PERSONAL WEBSITE & SECURE CMS ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMINISTRATOR SECURITY & IDENTITY WHITELIST (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Only this email is granted administrative access.
ADMIN_EMAIL=vivekdhoundiyal2901@gmail.com

# Whitelisted GitHub handle
GITHUB_ADMIN_USER=VivekDhoundiyal

# Master Passphrase & HMAC Secret (Set a strong 32+ character string in production)
ADMIN_SECRET=generate-a-strong-32-char-random-secret-here

# ------------------------------------------------------------------------------
# 2. GIT-BASED PUBLISHING PIPELINE (OPTIONAL FOR AUTOMATED COMMITS)
# ------------------------------------------------------------------------------
# When configured, clicking "Save & Publish" in /admin commits directly to GitHub,
# automatically triggering your Cloudflare Pages or GitHub Pages rebuild.
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_REPO=VivekDhoundiyal/portfolio
GITHUB_BRANCH=main

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE ACCESS ZERO TRUST (OPTIONAL / 100% FREE TIER)
# ------------------------------------------------------------------------------
# If you place Cloudflare Access in front of /admin/*, Cloudflare automatically
# sends the header "Cf-Access-Authenticated-User-Email".
# The server verifies this header against ADMIN_EMAIL above.

# ------------------------------------------------------------------------------
# 4. GOOGLE ANALYTICS 4 MEASUREMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Set your Google Analytics 4 Measurement ID here (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
